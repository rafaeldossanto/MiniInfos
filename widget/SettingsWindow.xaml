<Window x:Class="MiniInfos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniInfos"
        Title="Configurações do MiniInfos"
        Width="520"
        Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFont}"
        FontSize="12"
        Foreground="{DynamicResource PrimaryText}"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <ResourceDictionary Source="SettingsStyles.xaml" />
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="12">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent" MouseLeftButtonDown="OnTitlePressed">
                <TextBlock Text="Configurações" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}" HorizontalAlignment="Right"
                        Margin="0,0,10,0" Click="OnClose" ToolTip="Fechar">
                    <TextBlock Text="&#xE711;" />
                </Button>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" />

            <TabControl x:Name="Pages" Style="{StaticResource SettingsPages}">
                <TabItem x:Name="GeneralPage" Header="Geral" Tag="&#xE713;">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Sempre por cima"
                                                Tag="O cartão fica na frente das outras janelas.">
                            <CheckBox x:Name="TopmostToggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsTopmost}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Acompanhar o Claude e o Codex"
                                                Tag="Aparece quando um deles abre e some quando o último fecha.">
                            <CheckBox x:Name="FollowToggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FollowsApps}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Iniciar com o Windows"
                                                Tag="Abre sozinho quando você entra no Windows.">
                            <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}"
                                      Checked="OnStartupToggled" Unchecked="OnStartupToggled" />
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="AppearancePage" Header="Aparência" Tag="&#xE790;">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Tema" />
                            <TextBlock Text="Windows segue o modo claro ou escuro do sistema."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SimpleTheme" Style="{StaticResource Segment}" GroupName="Theme"
                                                 Content="Simples" Tag="{x:Static local:ThemeChoice.Simple}" Checked="OnThemeChosen" />
                                    <RadioButton x:Name="ClassicTheme" Style="{StaticResource Segment}" GroupName="Theme"
                                                 Content="Clássico" Tag="{x:Static local:ThemeChoice.Classic}" Checked="OnThemeChosen" />
                                    <RadioButton x:Name="LightTheme" Style="{StaticResource Segment}" GroupName="Theme"
                                                 Content="Claro" Tag="{x:Static local:ThemeChoice.Light}" Checked="OnThemeChosen" />
                                    <RadioButton x:Name="SystemTheme" Style="{StaticResource Segment}" GroupName="Theme"
                                                 Content="Windows" Tag="{x:Static local:ThemeChoice.System}" Checked="OnThemeChosen" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Este cartão" Style="{StaticResource SectionTitle}" />
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Números"
                                                Tag="Resumido: 1,4B. Detalhado: cada dígito.">
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CompactNumbers" Style="{StaticResource Segment}" GroupName="Numbers"
                                                 Content="Resumido" Checked="OnNumbersChosen" />
                                    <RadioButton x:Name="DetailedNumbers" Style="{StaticResource Segment}" GroupName="Numbers"
                                                 Content="Detalhado" Checked="OnNumbersChosen" />
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Lugar e tamanho"
                                                Tag="Volta pro canto ou pro tamanho original.">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SettingsButton}" Content="Pro canto" Click="OnBackToCorner" />
                                <Button Style="{StaticResource SettingsButton}" Content="Tamanho padrão" Margin="6,0,0,0"
                                        Click="OnDefaultSize" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="AboutPage" Header="Sobre" Tag="&#xE946;">
                    <StackPanel>
                        <TextBlock Text="MiniInfos" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="Limites e tokens do Claude e do Codex, num cartão sempre à mão." TextWrapping="Wrap"
                                   Margin="0,12,0,20" />
                        <Button Style="{StaticResource SettingsButton}" Content="Sair do MiniInfos" HorizontalAlignment="Left"
                                Click="OnQuit" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
