<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Claro: the same brushes as Simple.xaml, for a light desktop. -->
    <SolidColorBrush x:Key="CardBackground" Color="#F2F8F8FA" />
    <SolidColorBrush x:Key="CardBorder" Color="#24000000" />
    <SolidColorBrush x:Key="PrimaryText" Color="#1D1D1F" />
    <SolidColorBrush x:Key="DimText" Color="#6B6B70" />
    <SolidColorBrush x:Key="Divider" Color="#17000000" />
    <SolidColorBrush x:Key="Track" Color="#1C000000" />
    <SolidColorBrush x:Key="Hover" Color="#12000000" />
    <SolidColorBrush x:Key="Selected" Color="#1C000000" />
    <SolidColorBrush x:Key="SelectedBorder" Color="#2B000000" />
    <SolidColorBrush x:Key="IconOther" Color="#B5B5BA" />
    <SolidColorBrush x:Key="MenuBackground" Color="#FAFAFC" />
    <SolidColorBrush x:Key="MenuBorder" Color="#D6D6DB" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#EBEBEF" />
    <SolidColorBrush x:Key="MenuDisabled" Color="#A3A3A8" />
    <SolidColorBrush x:Key="Accent" Color="#2E6FE0" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Warning" Color="#C7871A" />
    <SolidColorBrush x:Key="Danger" Color="#D64038" />
</ResourceDictionary>
