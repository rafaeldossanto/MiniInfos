<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- What the card and each page column draw with, kept once for both. -->
    <SolidColorBrush x:Key="DimText" Color="#8F8F8F" />
    <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF" />

    <Style x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Margin" Value="0,5,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2.5" Background="#2EFFFFFF" />
                        <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource DimText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="BigCount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
</ResourceDictionary>
