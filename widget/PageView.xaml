<UserControl x:Class="MiniInfos.PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="234">
    <!-- One provider's page: the card shows one, or two side by side. -->
    <UserControl.Resources>
        <ResourceDictionary Source="CardStyles.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,6">
            <TextBlock x:Name="PageTitle" FontWeight="SemiBold" />
            <TextBlock x:Name="Note" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>

        <Grid>
            <TextBlock x:Name="ShortLabel" />
            <TextBlock x:Name="ShortPercent" HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>
        <ProgressBar x:Name="ShortBar" Style="{StaticResource Meter}" />
        <TextBlock x:Name="ShortDetail" Style="{StaticResource Caption}" />

        <Grid Margin="0,10,0,0">
            <TextBlock x:Name="LongLabel" />
            <TextBlock x:Name="LongPercent" HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>
        <ProgressBar x:Name="LongBar" Style="{StaticResource Meter}" />
        <TextBlock x:Name="LongDetail" Style="{StaticResource Caption}" />

        <Border Height="1" Background="{StaticResource Divider}" Margin="0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TodayBlock" Background="Transparent">
                <TextBlock Text="Tokens hoje" Style="{StaticResource Caption}" />
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock x:Name="TodayTokens" Style="{StaticResource BigCount}" />
                </Viewbox>
            </StackPanel>
            <StackPanel x:Name="TotalBlock" Grid.Column="1" Background="Transparent" Margin="6,0,0,0">
                <TextBlock Text="Tokens no total" Style="{StaticResource Caption}" />
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock x:Name="TotalTokens" Style="{StaticResource BigCount}" />
                </Viewbox>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ChatText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
