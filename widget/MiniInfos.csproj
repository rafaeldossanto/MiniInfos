<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniInfos</RootNamespace>
    <AssemblyName>MiniInfos</AssemblyName>
    <ApplicationIcon>Assets\MiniInfos.ico</ApplicationIcon>
    <!-- The one version: build.ps1 hands it to the installer, and the app tells it to codex. -->
    <Version>1.10.0</Version>
    <!-- The source-generated P/Invoke in DesktopApps. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- What ships carries nothing of the machine it was built on: no symbols file, no build paths. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=MiniInfos</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms is here for the tray icon alone: its names stay out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\MiniInfos.ico" />
    <Resource Include="Assets\athena-header.png" />
    <Resource Include="Assets\athena-owl-smooth.png" />
    <Resource Include="Assets\athena-owl-interactions.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\OFL*.txt" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="MiniInfos.Tests" />
  </ItemGroup>

</Project>
