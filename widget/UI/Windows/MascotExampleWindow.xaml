<local:DialogWindow x:Class="MiniInfos.UI.Windows.MascotExampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniInfos.UI.Windows"
        Title="Exemplo de mascote"
        Width="640"
        Height="580">

    <DockPanel>
        <!-- Saving stays in reach however far the example is scrolled. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}">
            <DockPanel Margin="20,12,20,14">
                <Button x:Name="SaveTemplateButton" DockPanel.Dock="Left" Content="Salvar modelo" Style="{StaticResource SettingsButton}"
                        Click="OnSaveTemplate" IsEnabled="False" ToolTip="Salva um .miniinfos com a grade, o manifesto e as instruções" />
                <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
        </Border>

        <Border Margin="20,16,20,0">
            <ScrollViewer x:Name="ExampleScroll" Style="{StaticResource SettingsScroll}">
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Um mascote é uma imagem PNG em grade: cada linha é um estado e cada coluna é um quadro da animação. Este é o modelo da Coruja de Atena. Salve o modelo, desenhe sua personagem por cima mantendo a grade e adicione pelo + na página Mascote." />

                    <TextBlock x:Name="Loading" Text="Montando o exemplo…" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                    <Grid x:Name="Sheet" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="RowLabels" />
                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Image x:Name="SheetImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <UniformGrid x:Name="GridLines" IsHitTestVisible="False" />
                            <!-- Each cell draws its right and bottom lines: the grid's left and top edges close it. -->
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1,1,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="manifest.json" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Um trecho com dois estados. O modelo salvo traz todos os estados, as durações de cada quadro e a anatomia usada pela física." />
                    <Border Background="{DynamicResource Track}" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <TextBlock x:Name="ManifestText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</local:DialogWindow>
