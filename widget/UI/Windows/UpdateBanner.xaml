<Window x:Class="MiniInfos.UI.Windows.UpdateBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
        Title="{loc:Text 'Atualização do MiniInfos'}"
        Width="296"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="{DynamicResource CardFont}"
        FontSize="13"
        Foreground="{DynamicResource PrimaryText}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiniInfos;component/UI/Styles/CardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The banner's one action, in the theme's accent. -->
            <Style x:Key="DownloadButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Padding="10,4" CornerRadius="6" Background="{DynamicResource Accent}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Clicking the line or the button updates: the app closes and opens again in the new version. -->
    <Border x:Name="Strip" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="12,6,6,6" Cursor="Hand"
            RenderOptions.ClearTypeHint="Enabled" MouseLeftButtonUp="OnStripClicked">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Message" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
            <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource DownloadButton}" Click="OnDownload">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="ButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
