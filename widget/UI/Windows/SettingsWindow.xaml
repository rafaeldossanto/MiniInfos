<Window x:Class="MiniInfos.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
        xmlns:mascot="clr-namespace:MiniInfos.Mascot"
        Title="{loc:Text 'Configurações do MiniInfos'}"
        Width="600"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFont}"
        FontSize="12"
        Foreground="{DynamicResource PrimaryText}"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <ResourceDictionary Source="/MiniInfos;component/UI/Styles/SettingsStyles.xaml" />
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="12" RenderOptions.ClearTypeHint="Enabled">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent" MouseLeftButtonDown="OnTitlePressed">
                <TextBlock Text="{loc:Text 'Configurações'}" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}" HorizontalAlignment="Right"
                        Margin="0,0,10,0" Click="OnClose" ToolTip="{loc:Text 'Fechar'}">
                    <TextBlock Text="&#xE711;" />
                </Button>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" />

            <TabControl x:Name="Pages" Style="{StaticResource SettingsPages}">
                <TabItem x:Name="GeneralPage" Header="{loc:Text 'Geral'}" Tag="&#xE713;">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Idioma'}"
                                                Tag="{loc:Text 'Use o idioma do Windows ou escolha o seu.'}">
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel x:Name="LanguageChoices" Orientation="Horizontal">
                                    <RadioButton Tag="Automatic" GroupName="Language" Style="{StaticResource Segment}"
                                                 Content="{loc:Text 'Automático'}" Checked="OnLanguageChosen" />
                                    <RadioButton Tag="Portuguese" GroupName="Language" Style="{StaticResource Segment}"
                                                 Content="Português" Checked="OnLanguageChosen" />
                                    <RadioButton Tag="English" GroupName="Language" Style="{StaticResource Segment}"
                                                 Content="English" Checked="OnLanguageChosen" />
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Cartão principal'}"
                                                Tag="{loc:Text 'O que abre junto com as IAs, com o Windows e pela bandeja. O outro abre pelo botão ao lado da engrenagem.'}">
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel x:Name="MainCardChoices" Orientation="Horizontal">
                                    <RadioButton Tag="Usage" GroupName="MainCard" Style="{StaticResource Segment}"
                                                 Content="{loc:Text 'Uso'}" Checked="OnMainCardChosen" />
                                    <RadioButton Tag="Conversations" GroupName="MainCard" Style="{StaticResource Segment}"
                                                 Content="{loc:Text 'Conversas'}" Checked="OnMainCardChosen" />
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Sempre por cima'}"
                                                Tag="{loc:Text 'O cartão fica na frente das outras janelas.'}">
                            <CheckBox x:Name="TopmostToggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsTopmost}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Acompanhar os apps de IA'}"
                                                Tag="{loc:Text 'Aparece quando um deles abre e some quando o último fecha.'}">
                            <CheckBox x:Name="FollowToggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FollowsApps}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Iniciar com o Windows'}"
                                                Tag="{loc:Text 'Abre sozinho quando você entra no Windows.'}">
                            <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}"
                                      Checked="OnStartupToggled" Unchecked="OnStartupToggled" />
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="AppearancePage" Header="{loc:Text 'Aparência'}" Tag="&#xE790;">
                    <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{loc:Text 'Tema'}" />
                            <TextBlock Text="{loc:Text 'O último tema escolhido fica em primeiro. A Biblioteca mostra todos, com prévia.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <!-- Filled from the theme history: the one in use first, built-in and community alike. -->
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                <StackPanel x:Name="ThemeChoices" Orientation="Horizontal" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ThemeLibraryButton" Content="{loc:Text 'Biblioteca'}" Style="{StaticResource SettingsButton}"
                                        Click="OnShowThemeLibrary" ToolTip="{loc:Text 'Todos os temas, com prévia'}" />
                                <Button x:Name="AddThemePackage" Content="{loc:Text 'Adicionar tema'}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" Click="OnAddTheme" />
                                <Button x:Name="ExportThemePackage" Content="{loc:Text 'Exportar'}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" Click="OnExportTheme" />
                                <Button x:Name="RemoveThemePackage" Content="{loc:Text 'Remover'}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" Click="OnRemoveTheme" />
                            </StackPanel>
                            <TextBlock x:Name="ThemePackageStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{loc:Text 'Adicione temas da comunidade ou exporte um modelo para criar o seu.'}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{loc:Text 'Fontes'}" />
                            <TextBlock Text="{loc:Text 'Escolha a fonte dos textos e dos números.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text 'Textos'}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                    <StackPanel x:Name="TextFontChoices" Orientation="Horizontal" />
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text 'Números'}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                    <StackPanel x:Name="NumberFontChoices" Orientation="Horizontal" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="FontPreview" FontFamily="{DynamicResource CardFont}"
                                       Foreground="{DynamicResource DimText}" Margin="64,8,0,0" />
                        </StackPanel>

                        <TextBlock Text="{loc:Text 'Este cartão'}" Style="{StaticResource SectionTitle}" />
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Números'}"
                                                Tag="{loc:Text 'Resumido: 1,4B. Detalhado: cada dígito.'}">
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CompactNumbers" Style="{StaticResource Segment}" GroupName="Numbers"
                                                 Content="{loc:Text 'Resumido'}" Checked="OnNumbersChosen" />
                                    <RadioButton x:Name="DetailedNumbers" Style="{StaticResource Segment}" GroupName="Numbers"
                                                 Content="{loc:Text 'Detalhado'}" Checked="OnNumbersChosen" />
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Lugar e tamanho'}"
                                                Tag="{loc:Text 'Volta pro canto ou pro tamanho original.'}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SettingsButton}" Content="{loc:Text 'Pro canto'}" Click="OnBackToCorner" />
                                <Button Style="{StaticResource SettingsButton}" Content="{loc:Text 'Tamanho padrão'}" Margin="6,0,0,0"
                                        Click="OnDefaultSize" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="PetPage" Header="{loc:Text 'Mascote'}">
                    <TabItem.Tag>
                        <Viewbox Width="14" Height="14" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" StrokeThickness="1.5"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <Ellipse Canvas.Left="6" Canvas.Top="7" Width="5" Height="7"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <Ellipse Canvas.Left="13" Canvas.Top="7" Width="5" Height="7"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <Ellipse Canvas.Left="8.3" Canvas.Top="7.4" Width="2.3" Height="3.4" Fill="{DynamicResource CardBackground}" />
                                <Ellipse Canvas.Left="15.3" Canvas.Top="7.4" Width="2.3" Height="3.4" Fill="{DynamicResource CardBackground}" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="PetPreview" Width="144" Height="144"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PetName" Text="{loc:Text 'Coruja de Atena'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Text 'Uma companhia para acompanhar seus tokens.'}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="CommunityPetChoices" Margin="0,0,0,4">
                            <Button x:Name="AddPetPackage" Style="{StaticResource PetLibraryAdd}" Click="OnAddPet"
                                    ToolTip="{loc:Text 'Adicionar mascote'}" AutomationProperties.Name="{loc:Text 'Adicionar mascote'}">
                                <Viewbox Width="40" Height="48" IsHitTestVisible="False">
                                    <Canvas Width="40" Height="48">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.2" StrokeDashArray="2.5,2.5" StrokeDashCap="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M20,2 C8,2 5,4 5,15 C2,15 2,22 5,22
                                                    C5,26 7,28 13,29 L10,33 L8,40 Q8,42 11,42
                                                    L13,36 L14,42 L11,44 Q9,46 15,46 L18,46
                                                    L20,39 L22,46 L25,46 Q31,46 29,44 L26,42
                                                    L27,36 L29,42 Q32,42 32,40 L30,33 L27,29
                                                    C33,28 35,26 35,22 C38,22 38,15 35,15
                                                    C35,4 32,2 20,2 Z" />
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M16,17 H24 M20,13 V21" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <RadioButton x:Name="AthenaPet" GroupName="MascotChoice"
                                         Style="{StaticResource PetLibraryChoice}" Checked="OnAthenaChosen"
                                         ToolTip="{loc:Text 'Coruja de Atena · Incluída no MiniInfos'}" AutomationProperties.Name="{loc:Text 'Coruja de Atena'}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="ExportPetPackage" Content="{loc:Text 'Exportar'}" Style="{StaticResource SettingsButton}" Click="OnExportPet" />
                            <Button x:Name="RemovePetPackage" Content="{loc:Text 'Remover'}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" Click="OnRemovePet" />
                            <Button x:Name="PetExampleButton" Content="{loc:Text 'Exemplo'}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" Click="OnShowPetExample"
                                    ToolTip="{loc:Text 'Mostra a grade e o manifesto de um mascote, com o modelo para criar o seu'}" />
                        </StackPanel>
                        <TextBlock x:Name="PetPackageStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{loc:Text 'Use + para adicionar um mascote e clique em uma miniatura para selecionar. Exporte para compartilhar ou criar o seu.'}" />
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Mostrar mascote'}"
                                                Tag="{loc:Text 'Fica solto na área de trabalho, mesmo com o cartão escondido.'}">
                            <CheckBox x:Name="PetToggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PetEnabled}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{loc:Text 'Tamanho'}">
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SmallPet" Style="{StaticResource Segment}" GroupName="PetSize"
                                                 Content="{loc:Text 'Pequeno'}" Tag="{x:Static mascot:PetSizeChoice.Small}" Checked="OnPetSizeChosen" />
                                    <RadioButton x:Name="MediumPet" Style="{StaticResource Segment}" GroupName="PetSize"
                                                 Content="{loc:Text 'Médio'}" Tag="{x:Static mascot:PetSizeChoice.Medium}" Checked="OnPetSizeChosen" />
                                    <RadioButton x:Name="LargePet" Style="{StaticResource Segment}" GroupName="PetSize"
                                                 Content="{loc:Text 'Grande'}" Tag="{x:Static mascot:PetSizeChoice.Large}" Checked="OnPetSizeChosen" />
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>
                        <TextBlock Text="{loc:Text 'Toque nos olhos para brincar. Segure pela cabeça, braços ou asas, barriga ou pés para mover. Clique duplo para mostrar o MiniInfos. Alt + roda muda o tamanho.'}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Text 'O mascote se anima quando os tokens aumentam, fica atento em 90% de uso e dorme após dois minutos sem novos tokens.'}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="CommunityPage" Header="{loc:Text 'Comunidade'}" Tag="&#xE716;">
                    <ScrollViewer x:Name="CatalogScroll" Style="{StaticResource SettingsScroll}" ScrollChanged="OnCatalogScrolled">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="RefreshCatalog" DockPanel.Dock="Right" Content="{loc:Text 'Atualizar lista'}"
                                        Style="{StaticResource SettingsButton}" Click="OnRefreshCatalog" Margin="8,0,0,0" />
                                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CatalogMascots" GroupName="CatalogKind" Content="{loc:Text 'Mascotes'}"
                                                     Style="{StaticResource Segment}" IsChecked="True" Checked="OnCatalogKindChosen" />
                                        <RadioButton x:Name="CatalogThemes" GroupName="CatalogKind" Content="{loc:Text 'Temas'}"
                                                     Style="{StaticResource Segment}" Checked="OnCatalogKindChosen" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="CatalogStatus" Text="{loc:Text 'Explore mascotes e temas da comunidade.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel x:Name="CatalogChoices" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="AboutPage" Header="{loc:Text 'Sobre'}" Tag="&#xE946;">
                    <StackPanel>
                        <TextBlock Text="MiniInfos" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{loc:Text 'Limites e tokens das suas IAs, num cartão sempre à mão.'}" TextWrapping="Wrap"
                                   Margin="0,12,0,20" />
                        <Button Style="{StaticResource SettingsButton}" Content="{loc:Text 'Sair do MiniInfos'}" HorizontalAlignment="Left"
                                Click="OnQuit" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
