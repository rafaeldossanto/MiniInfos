<Window x:Class="MiniInfos.UI.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniInfos.UI.Controls"
        Title="Mascote — MiniInfos" Width="160" Height="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource PrimaryText}"
        MouseLeftButtonDown="OnPressed" MouseLeftButtonUp="OnReleased" MouseMove="OnMoved"
        LostMouseCapture="OnCaptureLost" PreviewMouseWheel="OnWheel">
    <Image x:Name="Sprite" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
           Cursor="Hand" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.ContextMenu>
            <local:CardContextMenu>
                <MenuItem Header="Mostrar MiniInfos" Click="OnShowCards" />
                <MenuItem Header="Configurar mascote" Click="OnSettings" />
                <MenuItem Header="Voltar pro canto" Click="OnBackToCorner" />
                <Separator />
                <MenuItem Header="Esconder mascote" Click="OnHidePet" />
                <MenuItem Header="Sair do MiniInfos" Click="OnQuit" />
            </local:CardContextMenu>
        </Image.ContextMenu>
    </Image>
</Window>
