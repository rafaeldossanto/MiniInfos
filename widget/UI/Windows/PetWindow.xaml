<Window x:Class="MiniInfos.UI.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
        xmlns:local="clr-namespace:MiniInfos.UI.Controls"
        Title="{loc:Text 'Mascote — MiniInfos'}" Width="160" Height="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource PrimaryText}"
        MouseLeftButtonDown="OnPressed" MouseLeftButtonUp="OnReleased" MouseMove="OnMoved"
        LostMouseCapture="OnCaptureLost" PreviewMouseWheel="OnWheel">
    <Image x:Name="Sprite" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
           Cursor="Hand" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.ContextMenu>
            <local:CardContextMenu>
                <MenuItem Header="{loc:Text 'Mostrar MiniInfos'}" Click="OnShowCards" />
                <MenuItem Header="{loc:Text 'Configurar mascote'}" Click="OnSettings" />
                <MenuItem Header="{loc:Text 'Voltar pro canto'}" Click="OnBackToCorner" />
                <Separator />
                <MenuItem Header="{loc:Text 'Esconder mascote'}" Click="OnHidePet" />
                <MenuItem Header="{loc:Text 'Sair do MiniInfos'}" Click="OnQuit" />
            </local:CardContextMenu>
        </Image.ContextMenu>
    </Image>
</Window>
