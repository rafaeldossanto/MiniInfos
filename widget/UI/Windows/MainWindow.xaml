<Window x:Class="MiniInfos.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
        xmlns:local="clr-namespace:MiniInfos.UI.Controls"
        Title="MiniInfos"
        Width="296"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Opacity="0"
        FontFamily="{DynamicResource CardFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryText}"
        PreviewKeyDown="OnPageKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/MiniInfos;component/UI/Styles/CardStyles.xaml" />
            <ResourceDictionary Source="/MiniInfos;component/UI/Icons/ProviderIcons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border x:Name="Card"
                Width="296"
                CornerRadius="16"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Padding="0"
                RenderOptions.ClearTypeHint="Enabled"
                Focusable="True"
                MouseLeftButtonDown="OnCardPressed"
                PreviewMouseWheel="OnCardWheel">
            <Border.ContextMenu>
                <local:CardContextMenu>
                    <MenuItem Header="{loc:Text 'Atualizar agora'}" Click="OnRefresh" />
                    <Separator />
                    <!-- Checked and unchecked through the shared settings, bound in code. -->
                    <MenuItem x:Name="TopmostItem" Header="{loc:Text 'Sempre por cima'}" IsCheckable="True" />
                    <MenuItem Header="{loc:Text 'Voltar pro canto'}" Click="OnBackToCorner" />
                    <MenuItem Header="{loc:Text 'Tamanho padrão'}" Click="OnDefaultSize" />
                    <MenuItem Header="{loc:Text 'Configurações'}" Click="OnSettings" />
                    <Separator />
                    <MenuItem x:Name="DismissItem" Click="OnDismiss" />
                    <MenuItem Header="{loc:Text 'Sair do MiniInfos'}" Click="OnQuit" />
                </local:CardContextMenu>
            </Border.ContextMenu>

            <StackPanel>
                <Grid x:Name="HeaderRegion" Height="{DynamicResource HeaderHeight}">
                    <!-- Only the artwork is clipped to the card's rounded top: text under a clip loses ClearType
                         and turns grainy at small sizes, so nothing written sits inside this one. -->
                    <Grid x:Name="HeaderArt" IsHitTestVisible="False"
                          Tag="{DynamicResource HeaderArtworkInset}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="Margin" Value="12,44,12,12" />
                                    <Setter Property="Background" Value="#181818" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- A quiet extension fills wide cards while the complete portrait remains centered. -->
                    <Rectangle IsHitTestVisible="False" Visibility="{DynamicResource HeaderArtworkVisibility}">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{DynamicResource HeaderArtwork}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=HeaderArt}" Value="True">
                                        <Setter Property="Opacity" Value="0.18" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <!-- One centered illustration for the whole card, including split view. -->
                    <Image x:Name="AthenaArtwork" Source="{DynamicResource HeaderArtwork}"
                           Visibility="{DynamicResource HeaderArtworkVisibility}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="360" />
                                <Setter Property="Height" Value="120" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=HeaderArt}" Value="True">
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                <GradientStop Offset="0.12" Color="White" />
                                <GradientStop Offset="0.88" Color="White" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=HeaderArt}" Value="True">
                                        <Setter Property="Visibility" Value="{DynamicResource HeaderArtworkVisibility}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- Existing community overlays keep a feathered scrim behind their controls. -->
                    <Ellipse Width="120" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-12,-12,0" IsHitTestVisible="False">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="{DynamicResource HeaderArtworkVisibility}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=HeaderArt}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#D91F1F1F" />
                                <GradientStop Offset="0.45" Color="#801F1F1F" />
                                <GradientStop Offset="1" Color="#001F1F1F" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    </Grid>
                    <!-- How fresh the limits are sits beside each page's title, one page or two. -->
                    <Grid Margin="16,12" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppTitle" FontWeight="SemiBold" FontSize="{DynamicResource HeaderTitleSize}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource HeaderButton}" Click="OnRefresh">
                        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshSpin" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="DismissButton" Grid.Column="2" Style="{StaticResource HeaderButton}" Click="OnDismiss">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Divider}" VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel Margin="16,12,16,12">
                    <!-- One PageView per page on screen: one, or two side by side with a line between. -->
                    <StackPanel x:Name="Columns" Orientation="Horizontal" />

                    <Grid Margin="0,12,0,0">
                        <!-- The gear, under the name: the settings window; beside it, the conversations card. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" FontSize="12"
                                    Click="OnSettings" ToolTip="{loc:Text 'Configurações'}">
                                <TextBlock Text="&#xE713;" />
                            </Button>
                            <Button x:Name="ConversationsButton" Style="{StaticResource HeaderButton}" FontSize="12" Margin="2,0,0,0"
                                    Click="OnConversations" ToolTip="{loc:Text 'Conversas: os tokens de cada chat'}">
                                <TextBlock Text="&#xE8F2;" />
                            </Button>
                        </StackPanel>

                        <!-- Monochrome provider marks, centered in the card; the selected page's is lit. -->
                        <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="PreviousPageButton" Style="{StaticResource PageArrow}" Click="OnPreviousPage" ToolTip="{loc:Text 'Página anterior'}">
                                <Path Data="M5,0 L1,4 L5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                            <StackPanel x:Name="PageIcons" Orientation="Horizontal" VerticalAlignment="Center" Margin="1,0" />
                            <Button x:Name="NextPageButton" Style="{StaticResource PageArrow}" Click="OnNextPage" ToolTip="{loc:Text 'Próxima página'}">
                                <Path Data="M1,0 L5,4 L1,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="DetailedView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         ToolTip="{loc:Text 'Detalhado: números inteiros, subindo enquanto os tokens são gastos'}">
                                <Path Data="M0,1 H12 M0,5.5 H12 M0,10 H12" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton x:Name="CompactView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         Margin="2,0,0,0" ToolTip="{loc:Text 'Resumido: 1,4B, 109M'}">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" StrokeThickness="1.4"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
