<Window x:Class="MiniInfos.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
        xmlns:local="clr-namespace:MiniInfos.UI.Controls"
        Title="MiniInfos"
        Width="296"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Opacity="0"
        FontFamily="{DynamicResource CardFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryText}"
        PreviewKeyDown="OnPageKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/MiniInfos;component/UI/Styles/CardStyles.xaml" />
            <ResourceDictionary Source="/MiniInfos;component/UI/Icons/ProviderIcons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border x:Name="Card"
                Width="296"
                CornerRadius="16"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Padding="0"
                RenderOptions.ClearTypeHint="Enabled"
                Focusable="True"
                MouseLeftButtonDown="OnCardPressed"
                PreviewMouseWheel="OnCardWheel">
            <Border.ContextMenu>
                <local:CardContextMenu>
                    <MenuItem Header="{loc:Text 'Atualizar agora'}" Click="OnRefresh" />
                    <Separator />
                    <!-- Checked and unchecked through the shared settings, bound in code. -->
                    <MenuItem x:Name="TopmostItem" Header="{loc:Text 'Sempre por cima'}" IsCheckable="True" />
                    <MenuItem Header="{loc:Text 'Voltar pro canto'}" Click="OnBackToCorner" />
                    <MenuItem Header="{loc:Text 'Tamanho padrão'}" Click="OnDefaultSize" />
                    <MenuItem Header="{loc:Text 'Configurações'}" Click="OnSettings" />
                    <Separator />
                    <MenuItem x:Name="DismissItem" Click="OnDismiss" />
                    <MenuItem Header="{loc:Text 'Sair do MiniInfos'}" Click="OnQuit" />
                </local:CardContextMenu>
            </Border.ContextMenu>

            <StackPanel>
                <local:CardHeader x:Name="Header" RefreshRequested="OnRefresh" DismissRequested="OnDismiss" />

                <StackPanel Margin="16,12,16,12">
                    <!-- One PageView per page on screen: one, or two side by side with a line between. -->
                    <StackPanel x:Name="Columns" Orientation="Horizontal" />

                    <Grid Margin="0,12,0,0">
                        <!-- The gear, under the name: the settings window; beside it, the conversations card. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" FontSize="12"
                                    Click="OnSettings" ToolTip="{loc:Text 'Configurações'}">
                                <TextBlock Text="&#xE713;" />
                            </Button>
                            <Button x:Name="ConversationsButton" Style="{StaticResource HeaderButton}" FontSize="12" Margin="2,0,0,0"
                                    Click="OnConversations" ToolTip="{loc:Text 'Conversas: os tokens de cada chat'}">
                                <TextBlock Text="&#xE8F2;" />
                            </Button>
                        </StackPanel>

                        <!-- Monochrome provider marks, centered in the card; the selected page's is lit. -->
                        <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="PreviousPageButton" Style="{StaticResource PageArrow}" Click="OnPreviousPage" ToolTip="{loc:Text 'Página anterior'}">
                                <Path Data="M5,0 L1,4 L5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                            <StackPanel x:Name="PageIcons" Orientation="Horizontal" VerticalAlignment="Center" Margin="1,0" />
                            <Button x:Name="NextPageButton" Style="{StaticResource PageArrow}" Click="OnNextPage" ToolTip="{loc:Text 'Próxima página'}">
                                <Path Data="M1,0 L5,4 L1,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="DetailedView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         ToolTip="{loc:Text 'Detalhado: números inteiros, subindo enquanto os tokens são gastos'}">
                                <Path Data="M0,1 H12 M0,5.5 H12 M0,10 H12" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton x:Name="CompactView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         Margin="2,0,0,0" ToolTip="{loc:Text 'Resumido: 1,4B, 109M'}">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" StrokeThickness="1.4"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
