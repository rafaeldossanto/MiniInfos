<Window x:Class="MiniInfos.UI.Windows.ConversationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
        Title="MiniInfos"
        Width="296"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="{DynamicResource CardFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryText}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiniInfos;component/UI/Styles/CardStyles.xaml" />
                <ResourceDictionary Source="/MiniInfos;component/UI/Styles/SettingsStyles.xaml" />
                <ResourceDictionary Source="/MiniInfos;component/UI/Icons/ProviderIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Card"
            Width="296"
            CornerRadius="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled"
            MouseLeftButtonDown="OnCardPressed">
        <StackPanel>
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Text 'Conversas'}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Click="OnRefresh" ToolTip="{loc:Text 'Atualizar agora'}">
                    <TextBlock Text="&#xE72C;" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Click="OnDismiss" ToolTip="{loc:Text 'Esconder'}">
                    <TextBlock Text="&#xE711;" />
                </Button>
            </Grid>
            <Border Height="1" Background="{DynamicResource Divider}" />

            <StackPanel Margin="16,10,16,12">
                <Grid Margin="0,0,0,7">
                    <TextBlock Text="{loc:Text 'Respondeu por último primeiro'}" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="Tokens" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}" />

                <!-- The one that answered last on top, as the theme row keeps the last chosen first. -->
                <ScrollViewer x:Name="ListScroll" Style="{StaticResource SettingsScroll}" MaxHeight="336"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="13" Height="13" Stretch="Uniform"
                                              VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center"
                                                         Margin="0,0,5,0" Visibility="{Binding LiveVisibility}" />
                                                <TextBlock Text="{Binding Where}" Style="{StaticResource Caption}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Tokens}" FontFamily="{DynamicResource NumberFont}" FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" ToolTip="{Binding Breakdown}" />
                                            <TextBlock Text="{Binding Context}" Style="{StaticResource Caption}" FontSize="11"
                                                       HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Divider}" Visibility="{Binding DividerVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="Empty" Text="{loc:Text 'Nenhuma conversa com tokens ainda'}" Style="{StaticResource Caption}"
                           Margin="0,12,0,4" Visibility="Collapsed" />
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" />

                <Grid Margin="0,12,0,0">
                    <!-- The gear in its place; beside it, the usage card. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource HeaderButton}" FontSize="12" Click="OnSettings" ToolTip="{loc:Text 'Configurações'}">
                            <TextBlock Text="&#xE713;" />
                        </Button>
                        <Button x:Name="UsageButton" Style="{StaticResource HeaderButton}" FontSize="12" Margin="2,0,0,0"
                                Click="OnUsage" ToolTip="{loc:Text 'Uso: os limites e os tokens de cada IA'}">
                            <TextBlock Text="&#xEC4A;" />
                        </Button>
                    </StackPanel>

                    <!-- Each provider's mark filters the list to it; pressed again, every provider shows. -->
                    <StackPanel x:Name="Filters" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="DetailedView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                     ToolTip="{loc:Text 'Detalhado: números inteiros, subindo enquanto os tokens são gastos'}">
                            <Path Data="M0,1 H12 M0,5.5 H12 M0,10 H12" StrokeThickness="1.4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="CompactView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                     Margin="2,0,0,0" ToolTip="{loc:Text 'Resumido: 1,4B, 109M'}">
                            <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" StrokeThickness="1.4"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
