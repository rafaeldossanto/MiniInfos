<UserControl x:Class="MiniInfos.UI.Controls.PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization"
             Width="262">
    <!-- One provider's page: the card shows one, or two side by side. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/MiniInfos;component/UI/Styles/CardStyles.xaml" />
    </UserControl.Resources>

    <Grid>
        <!-- Hidden, not collapsed, until the first read: the page keeps the size it will have filled,
             each line holding a dash, while it says it is reading. -->
        <StackPanel x:Name="Numbers" Visibility="Hidden">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" Text="—" FontWeight="SemiBold" FontSize="16" />
                <TextBlock x:Name="Note" Text="—" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>

            <Grid>
                <TextBlock x:Name="ShortLabel" Text="—" />
                <TextBlock x:Name="ShortPercent" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}" />
            </Grid>
            <ProgressBar x:Name="ShortBar" Style="{StaticResource Meter}" />
            <TextBlock x:Name="ShortDetail" Text="—" Style="{StaticResource Caption}" />

            <Grid Margin="0,12,0,0">
                <TextBlock x:Name="LongLabel" Text="—" />
                <TextBlock x:Name="LongPercent" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}" />
            </Grid>
            <ProgressBar x:Name="LongBar" Style="{StaticResource Meter}" />
            <TextBlock x:Name="LongDetail" Text="—" Style="{StaticResource Caption}" />

            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TodayBlock" Background="Transparent">
                    <TextBlock Text="{loc:Text 'Tokens hoje'}" Style="{StaticResource Caption}" />
                    <!-- Reserve the same line height even when a long count scales down. -->
                    <Viewbox Height="34" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="TodayTokens" Text="—" Style="{StaticResource BigCount}" />
                    </Viewbox>
                </StackPanel>
                <StackPanel x:Name="TotalBlock" Grid.Column="1" Background="Transparent" Margin="8,0,0,0">
                    <TextBlock Text="{loc:Text 'Tokens no total'}" Style="{StaticResource Caption}" />
                    <Viewbox Height="34" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="TotalTokens" Text="—" Style="{StaticResource BigCount}" />
                    </Viewbox>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ChatText" Text="—" Style="{StaticResource Caption}" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock x:Name="Reading" Text="{loc:Text 'Lendo o histórico…'}" Style="{StaticResource Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
