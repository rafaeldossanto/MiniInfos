<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniInfos.Localization">
    <!-- The settings window's controls, in the theme's colors like the card. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MiniInfos;component/UI/Styles/CardStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The pages: a rail of names on the left, the chosen page on the right. Adding a page is adding a TabItem. -->
    <Style x:Key="SettingsPages" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel IsItemsHost="True" Margin="8,12" KeyboardNavigation.TabNavigation="Once"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                        <Border Grid.Column="1" Background="{DynamicResource Divider}" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="2" ContentSource="SelectedContent"
                                          Margin="20,16,20,16" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The empty run above and below the thumb: a click there turns a page, and nothing is drawn. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No arrows and no track: a rounded thumb in the theme's colors, a little wider while it is pointed at or dragged. -->
    <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb x:Name="Thumb" Cursor="Arrow">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Bar" Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                                Background="{DynamicResource IconOther}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Width" Value="6" />
                                                <Setter TargetName="Bar" Property="CornerRadius" Value="3" />
                                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource DimText}" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Bar" Property="Width" Value="6" />
                                                <Setter TargetName="Bar" Property="CornerRadius" Value="3" />
                                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource DimText}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A page taller than the window scrolls with a thin bar in its right margin, so its rows keep the width the other pages have. -->
    <Style x:Key="SettingsScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Margin" Value="0,0,-16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SettingsScrollBar}"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A page's name in the rail; Tag holds its glyph from the Windows icon font. -->
    <Style TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource DimText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Row" Height="30" Margin="0,0,0,2" Padding="10,0" CornerRadius="6" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl Content="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                            Foreground="{TemplateBinding Foreground}" Width="14" Height="14" Focusable="False"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One setting: its name and a line on what it does, with its control at the right. -->
    <Style x:Key="SettingRow" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <ContentPresenter ContentSource="Header" />
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DimText}" />
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <!-- An on/off setting, drawn as a switch. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" BorderThickness="1"
                            Background="{DynamicResource Track}" BorderBrush="{DynamicResource SelectedBorder}">
                        <Ellipse x:Name="Thumb" Width="10" Height="10" Margin="4,0" HorizontalAlignment="Left"
                                 Fill="{DynamicResource DimText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentText}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Width" Value="12" />
                            <Setter TargetName="Thumb" Property="Height" Value="12" />
                            <Setter TargetName="Thumb" Property="Margin" Value="3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice among a few, side by side in one frame: the chosen one stays lit. -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource DimText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Padding="10,3" CornerRadius="5" BorderThickness="1"
                            Background="Transparent" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Padding="12,5" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Divider}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PetTileFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                            CornerRadius="8" Margin="-3" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PetLibraryAdd" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PetTileFocus}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PetLibraryChoice" TargetType="RadioButton">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PetTileFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Padding="4" CornerRadius="6" BorderThickness="1"
                            Background="Transparent" BorderBrush="{DynamicResource Divider}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PrimaryText}" />
                            <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CatalogCard" TargetType="Border">
        <Setter Property="Width" Value="194" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,8,12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    </Style>

    <!-- The frame of a DialogWindow: the settings' card, a title bar that drags it, ✕, and a line over the content. -->
    <ControlTemplate x:Key="DialogChrome" TargetType="Window">
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="12" RenderOptions.ClearTypeHint="Enabled">
            <DockPanel>
                <Grid x:Name="PART_TitleBar" DockPanel.Dock="Top" Height="40" Background="Transparent">
                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
                    <Button x:Name="PART_Close" Style="{DynamicResource HeaderButton}" HorizontalAlignment="Right"
                            Margin="0,0,10,0" ToolTip="{loc:Text 'Fechar'}">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" />
                <AdornerDecorator>
                    <ContentPresenter />
                </AdornerDecorator>
            </DockPanel>
        </Border>
    </ControlTemplate>
</ResourceDictionary>
