<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Simples: every theme names these same brushes, and every window takes them as dynamic resources. -->
    <SolidColorBrush x:Key="CardBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CardBorder" Color="#414144" />
    <SolidColorBrush x:Key="PrimaryText" Color="#EDEDED" />
    <SolidColorBrush x:Key="DimText" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Divider" Color="#353535" />
    <SolidColorBrush x:Key="Track" Color="#313131" />
    <SolidColorBrush x:Key="Hover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Selected" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SelectedBorder" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="IconOther" Color="#55565A" />
    <SolidColorBrush x:Key="MenuBackground" Color="#272727" />
    <SolidColorBrush x:Key="MenuBorder" Color="#414144" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#313131" />
    <SolidColorBrush x:Key="MenuDisabled" Color="#6D6D70" />
    <SolidColorBrush x:Key="Accent" Color="#4C8DF6" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Warning" Color="#E3A33B" />
    <SolidColorBrush x:Key="Danger" Color="#E5534B" />
</ResourceDictionary>
