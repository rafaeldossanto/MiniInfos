<Window x:Class="MiniInfos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniInfos"
        Title="MiniInfos"
        Width="296"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Opacity="0"
        FontFamily="{DynamicResource AppFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryText}"
        PreviewKeyDown="OnPageKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="CardStyles.xaml" />
            <ResourceDictionary Source="ProviderIcons.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- The two view buttons, as in Explorer's corner: the chosen one stays lit. -->
        <Style x:Key="ViewSwitch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="View" />
            <Setter Property="Foreground" Value="{DynamicResource DimText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Width="22" Height="18" CornerRadius="4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageArrow" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DimText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border x:Name="Card"
                Width="296"
                CornerRadius="16"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Padding="0"
                Focusable="True"
                MouseLeftButtonDown="OnCardPressed"
                PreviewMouseWheel="OnCardWheel">
            <Border.ContextMenu>
                <local:CardContextMenu>
                    <MenuItem Header="Atualizar agora" Click="OnRefresh" />
                    <Separator />
                    <!-- Checked and unchecked through the shared settings, bound in code. -->
                    <MenuItem x:Name="TopmostItem" Header="Sempre por cima" IsCheckable="True" />
                    <MenuItem Header="Voltar pro canto" Click="OnBackToCorner" />
                    <MenuItem Header="Tamanho padrão" Click="OnDefaultSize" />
                    <MenuItem Header="Configurações" Click="OnSettings" />
                    <Separator />
                    <MenuItem x:Name="DismissItem" Click="OnDismiss" />
                    <MenuItem Header="Sair do MiniInfos" Click="OnQuit" />
                </local:CardContextMenu>
            </Border.ContextMenu>

            <StackPanel>
                <Grid x:Name="HeaderRegion" Height="{DynamicResource HeaderHeight}">
                    <!-- One centered illustration for the whole card, including split view. -->
                    <Image x:Name="AthenaArtwork" Source="{DynamicResource HeaderArtwork}"
                           Visibility="{DynamicResource HeaderArtworkVisibility}"
                           Width="360" Height="120" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                <GradientStop Offset="0.12" Color="White" />
                                <GradientStop Offset="0.88" Color="White" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                    <!-- A feathered scrim has no rectangular blur boundary behind the controls. -->
                    <Ellipse Width="120" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-12,-12,0" IsHitTestVisible="False"
                             Visibility="{DynamicResource HeaderArtworkVisibility}">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#D91F1F1F" />
                                <GradientStop Offset="0.45" Color="#801F1F1F" />
                                <GradientStop Offset="1" Color="#001F1F1F" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- How fresh the limits are sits beside each page's title, one page or two. -->
                    <Grid Margin="16,12" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MiniInfos" FontWeight="SemiBold" FontSize="{DynamicResource HeaderTitleSize}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource HeaderButton}" Click="OnRefresh">
                        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshSpin" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="DismissButton" Grid.Column="2" Style="{StaticResource HeaderButton}" Click="OnDismiss">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Divider}" VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel Margin="16,12,16,12">
                    <!-- One PageView per page on screen: one, or two side by side with a line between. -->
                    <StackPanel x:Name="Columns" Orientation="Horizontal" />

                    <Grid Margin="0,12,0,0">
                        <!-- The gear, under the name: the settings window. -->
                        <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" FontSize="12"
                                HorizontalAlignment="Left" Click="OnSettings" ToolTip="Configurações">
                            <TextBlock Text="&#xE713;" />
                        </Button>

                        <!-- Monochrome provider marks, centered in the card; the selected page's is lit. -->
                        <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="PreviousPageButton" Style="{StaticResource PageArrow}" Click="OnPreviousPage" ToolTip="Página anterior">
                                <Path Data="M5,0 L1,4 L5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                            <StackPanel x:Name="PageIcons" Orientation="Horizontal" VerticalAlignment="Center" Margin="1,0" />
                            <Button x:Name="NextPageButton" Style="{StaticResource PageArrow}" Click="OnNextPage" ToolTip="Próxima página">
                                <Path Data="M1,0 L5,4 L1,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="DetailedView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         ToolTip="Detalhado: números inteiros, subindo enquanto os tokens são gastos">
                                <Path Data="M0,1 H12 M0,5.5 H12 M0,10 H12" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton x:Name="CompactView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         Margin="2,0,0,0" ToolTip="Resumido: 1,4B, 109M">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" StrokeThickness="1.4"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
