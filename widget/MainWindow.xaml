<Window x:Class="MiniInfos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniInfos"
        Width="264"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="#EDEDED">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="DimText" Color="#8F8F8F" />

        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Margin" Value="0,5,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="#2EFFFFFF" />
                            <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="BigCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- The two view buttons, as in Explorer's corner: the chosen one stays lit. -->
        <Style x:Key="ViewSwitch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="View" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Width="22" Height="18" CornerRadius="4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small glyph buttons of the header (refresh, hide), drawn with the Windows icon font. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Width="20" Height="20" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border x:Name="Card"
                Width="264"
                CornerRadius="12"
                Background="#F21C1C1E"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                Padding="14,8,10,12"
                MouseLeftButtonDown="OnCardPressed">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Atualizar agora" Click="OnRefresh" />
                    <Separator />
                    <MenuItem x:Name="TopmostItem" Header="Sempre por cima" IsCheckable="True" IsChecked="True"
                              Click="OnTopmostToggled" />
                    <MenuItem Header="Voltar pro canto" Click="OnBackToCorner" />
                    <MenuItem Header="Tamanho padrão" Click="OnDefaultSize" />
                    <Separator />
                    <MenuItem Header="Esconder" Click="OnHide" />
                    <MenuItem Header="Sair do MiniInfos" Click="OnQuit" />
                </ContextMenu>
            </Border.ContextMenu>

            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MiniInfos" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdatedText" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource HeaderButton}" Click="OnRefresh"
                            ToolTip="Atualizar agora. Os % de 5h e semanal mudam quando algum chat do Claude Code recebe resposta.">
                        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshSpin" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Click="OnHide"
                            ToolTip="Esconder (volta quando o Claude abrir de novo)">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel Margin="0,0,4,0">
                    <Grid>
                        <TextBlock Text="Janela 5h" />
                        <TextBlock x:Name="FiveHourPercent" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar x:Name="FiveHourBar" Style="{StaticResource Meter}" />
                    <TextBlock x:Name="FiveHourDetail" Style="{StaticResource Caption}" />

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Semanal" />
                        <TextBlock x:Name="WeekPercent" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar x:Name="WeekBar" Style="{StaticResource Meter}" />
                    <TextBlock x:Name="WeekDetail" Style="{StaticResource Caption}" />

                    <Border Height="1" Background="#1FFFFFFF" Margin="0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TodayBlock" Background="Transparent">
                            <TextBlock Text="Tokens hoje" Style="{StaticResource Caption}" />
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock x:Name="TodayTokens" Style="{StaticResource BigCount}" />
                            </Viewbox>
                        </StackPanel>
                        <StackPanel x:Name="TotalBlock" Grid.Column="1" Background="Transparent" Margin="6,0,0,0">
                            <TextBlock Text="Tokens no total" Style="{StaticResource Caption}" />
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock x:Name="TotalTokens" Style="{StaticResource BigCount}" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ChatText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,-4,0">
                            <RadioButton x:Name="DetailedView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         ToolTip="Detalhado: números inteiros, subindo enquanto os tokens são gastos">
                                <Path Data="M0,1 H12 M0,5.5 H12 M0,10 H12" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton x:Name="CompactView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         Margin="2,0,0,0" ToolTip="Resumido: 1,4B, 109M">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" StrokeThickness="1.4"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
