<Window x:Class="MiniInfos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniInfos"
        Title="MiniInfos"
        Width="264"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="#EDEDED"
        PreviewKeyDown="OnPageKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="CardStyles.xaml" />
            <ResourceDictionary Source="ProviderIcons.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- The two view buttons, as in Explorer's corner: the chosen one stays lit. -->
        <Style x:Key="ViewSwitch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="View" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Width="22" Height="18" CornerRadius="4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small glyph buttons of the header (refresh, hide), drawn with the Windows icon font. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Width="20" Height="20" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageArrow" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border x:Name="Card"
                Width="264"
                CornerRadius="12"
                Background="#F21C1C1E"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                Padding="14,8,10,6"
                Focusable="True"
                MouseLeftButtonDown="OnCardPressed"
                PreviewMouseWheel="OnCardWheel">
            <Border.ContextMenu>
                <local:CardContextMenu>
                    <MenuItem Header="Atualizar agora" Click="OnRefresh" />
                    <Separator />
                    <MenuItem x:Name="TopmostItem" Header="Sempre por cima" IsCheckable="True" IsChecked="True"
                              Click="OnTopmostToggled" />
                    <MenuItem Header="Voltar pro canto" Click="OnBackToCorner" />
                    <MenuItem Header="Tamanho padrão" Click="OnDefaultSize" />
                    <Separator />
                    <MenuItem x:Name="DismissItem" Click="OnDismiss" />
                    <MenuItem Header="Sair do MiniInfos" Click="OnQuit" />
                </local:CardContextMenu>
            </Border.ContextMenu>

            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MiniInfos" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdatedText" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource HeaderButton}" Click="OnRefresh">
                        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshSpin" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="DismissButton" Grid.Column="3" Style="{StaticResource HeaderButton}" Click="OnDismiss">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel Margin="0,0,4,0">
                    <!-- One PageView per page on screen: one, or two side by side with a line between. -->
                    <StackPanel x:Name="Columns" Orientation="Horizontal" />

                    <Grid Margin="-4,8,-4,0">
                        <!-- Monochrome provider marks, centered in the card; white marks the selected page. -->
                        <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="PreviousPageButton" Style="{StaticResource PageArrow}" Click="OnPreviousPage" ToolTip="Página anterior">
                                <Path Data="M5,0 L1,4 L5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                            <StackPanel x:Name="PageIcons" Orientation="Horizontal" VerticalAlignment="Center" Margin="1,0" />
                            <Button x:Name="NextPageButton" Style="{StaticResource PageArrow}" Click="OnNextPage" ToolTip="Próxima página">
                                <Path Data="M1,0 L5,4 L1,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Width="6" Height="8" Stretch="None" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="DetailedView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         ToolTip="Detalhado: números inteiros, subindo enquanto os tokens são gastos">
                                <Path Data="M0,1 H12 M0,5.5 H12 M0,10 H12" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton x:Name="CompactView" Style="{StaticResource ViewSwitch}" Checked="OnViewChanged"
                                         Margin="2,0,0,0" ToolTip="Resumido: 1,4B, 109M">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" StrokeThickness="1.4"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
