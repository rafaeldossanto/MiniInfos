{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo do MiniInfos",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "author", "version", "license", "description", "asset", "size", "sha256", "preview", "previewSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
        "kind": { "enum": ["mascot", "theme"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "maxLength": 40, "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" },
        "license": { "type": "string", "minLength": 1, "maxLength": 100, "not": { "pattern": "^[Uu][Nn][Ll][Ii][Cc][Ee][Nn][Ss][Ee][Dd]$" } },
        "description": { "type": "string", "maxLength": 600 },
        "asset": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}\\.miniinfos$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "preview": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}\\.png$" },
        "previewSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}
