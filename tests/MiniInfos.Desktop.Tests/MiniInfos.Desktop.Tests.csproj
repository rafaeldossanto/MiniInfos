<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../desktop/MiniInfos.Desktop.csproj" />
    <Compile Include="../MiniInfos.Tests/Providers/**/*.cs" Exclude="../MiniInfos.Tests/Providers/Codex/CodexCliTests.cs" LinkBase="Shared/Providers" />
    <Compile Include="../MiniInfos.Tests/Sources/*.cs;../MiniInfos.Tests/Infrastructure/Storage/*.cs;../MiniInfos.Tests/Support/TempFolder.cs;../MiniInfos.Tests/Support/LanguageDefaults.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
